<div class="grid grid-cols-3 gap-4 py-2 border-b border-slate-100 last:border-b-0">
    <div class="text-sm text-slate-500">@Label</div>
    <div class="text-sm text-slate-900 col-span-2 whitespace-pre-wrap">@Value</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
}