@using OrbitCRM.Domain.Enums

<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @_css">
    @Status
</span>

@code {
    [Parameter] public TaskItemStatus Status { get; set; }

    private string _css => Status switch
    {
        TaskItemStatus.Pending => "bg-slate-100 text-slate-700",
        TaskItemStatus.InProgress => "bg-blue-100 text-blue-700",
        TaskItemStatus.Completed => "bg-green-100 text-green-700",
        TaskItemStatus.Cancelled => "bg-red-100 text-red-700",
        _ => "bg-slate-100 text-slate-700"
    };
}