@using OrbitCRM.Application.Activities.DTOs
@using OrbitCRM.Application.Activities.Interfaces
@using OrbitCRM.Domain.Enums
@inject IActivityService ActivityService

<div class="bg-white border border-slate-200 rounded-lg p-4">
    <h3 class="text-sm font-medium text-slate-700 mb-3">Log activity</h3>

    <div class="flex gap-2 mb-3 flex-wrap">
        @foreach (var t in Enum.GetValues<ActivityType>())
        {
            <button type="button"
                    class="px-3 py-1.5 text-xs rounded-md border transition-colors @(_type == t ? "bg-blue-600 text-white border-blue-600" : "border-slate-300 hover:bg-slate-50")"
                    @onclick="() => _type = t">
                @t
            </button>
        }
    </div>

    <input type="text"
           placeholder="Subject"
           class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
           @bind="_subject" />

    <textarea placeholder="Details (optional)"
              rows="2"
              class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
              @bind="_description"></textarea>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mb-3 p-2 bg-red-50 border border-red-200 text-red-800 text-xs rounded-md">
            @_error
        </div>
    }

    <div class="flex justify-end">
        <button type="button"
                class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-md disabled:opacity-60"
                disabled="@_saving"
                @onclick="Save">
            @(_saving ? "Saving…" : "Log activity")
        </button>
    </div>
</div>

@code {
    [Parameter] public Guid? CustomerId { get; set; }
    [Parameter] public Guid? LeadId { get; set; }
    [Parameter] public Guid? DealId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private ActivityType _type = ActivityType.Note;
    private string _subject = string.Empty;
    private string? _description;
    private bool _saving;
    private string? _error;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_subject))
        {
            _error = "Subject is required.";
            return;
        }

        _saving = true;
        _error = null;

        try
        {
            var dto = new CreateActivityDto
            {
                Type = _type,
                Subject = _subject.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                OccurredAt = DateTime.UtcNow,
                CustomerId = CustomerId,
                LeadId = LeadId,
                DealId = DealId
            };

            var result = await ActivityService.CreateAsync(dto);

            if (result.IsSuccess)
            {
                _subject = string.Empty;
                _description = null;
                _type = ActivityType.Note;

                await OnSaved.InvokeAsync();
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _saving = false;
        }
    }
}