@using OrbitCRM.Application.Customers.Interfaces
@using OrbitCRM.Application.Leads.Interfaces
@using OrbitCRM.Application.Deals.Interfaces
@using OrbitCRM.Application.Customers.DTOs
@using OrbitCRM.Application.Leads.DTOs
@using OrbitCRM.Application.Deals.DTOs
@inject ICustomerService CustomerService
@inject ILeadService LeadService
@inject IDealService DealService
@inject NavigationManager Nav
@implements IDisposable

<div class="relative">
    <div class="relative">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text"
               placeholder="Search customers, leads, deals..."
               class="w-80 pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:bg-white transition-all"
               value="@_query"
               @oninput="OnSearchInput"
               @onfocus="OnFocus"
               @onkeydown="OnKeyDown" />
    </div>

    @if (_open && !string.IsNullOrWhiteSpace(_query))
    {
        <!-- Backdrop to close on outside click -->
        <div class="fixed inset-0 z-40" @onclick="Close"></div>

        <div class="absolute top-full left-0 right-0 mt-2 bg-white border border-slate-200 rounded-lg shadow-xl z-50 max-h-96 overflow-y-auto">
            @if (_loading)
            {
                <div class="px-4 py-3 text-sm text-slate-500">Searching…</div>
            }
            else if (_customers.Count == 0 && _leads.Count == 0 && _deals.Count == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-sm text-slate-500">No results for "@_query"</p>
                </div>
            }
            else
            {
                @if (_customers.Count > 0)
                {
                    <div class="border-b border-slate-100 last:border-0">
                        <div class="px-4 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50">Customers</div>
                        @foreach (var c in _customers)
                        {
                            var captured = c;
                            <button class="w-full text-left px-4 py-2.5 hover:bg-slate-50 transition-colors flex items-center justify-between"
                                    @onclick="() => GoToCustomer(captured.Id)">
                                <div>
                                    <div class="text-sm font-medium text-slate-900">@captured.FullName</div>
                                    <div class="text-xs text-slate-500">@captured.Email</div>
                                </div>
                                <span class="text-xs text-slate-400">Customer</span>
                            </button>
                        }
                    </div>
                }

                @if (_leads.Count > 0)
                {
                    <div class="border-b border-slate-100 last:border-0">
                        <div class="px-4 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50">Leads</div>
                        @foreach (var l in _leads)
                        {
                            var captured = l;
                            <button class="w-full text-left px-4 py-2.5 hover:bg-slate-50 transition-colors flex items-center justify-between"
                                    @onclick="() => GoToLead(captured.Id)">
                                <div>
                                    <div class="text-sm font-medium text-slate-900">@captured.FullName</div>
                                    <div class="text-xs text-slate-500">@captured.Email</div>
                                </div>
                                <span class="text-xs text-slate-400">Lead</span>
                            </button>
                        }
                    </div>
                }

                @if (_deals.Count > 0)
                {
                    <div>
                        <div class="px-4 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50">Deals</div>
                        @foreach (var d in _deals)
                        {
                            var captured = d;
                            <button class="w-full text-left px-4 py-2.5 hover:bg-slate-50 transition-colors flex items-center justify-between"
                                    @onclick="() => GoToDeal(captured.Id)">
                                <div>
                                    <div class="text-sm font-medium text-slate-900">@captured.Name</div>
                                    <div class="text-xs text-slate-500">@captured.Value.ToString("C0")</div>
                                </div>
                                <span class="text-xs text-slate-400">Deal</span>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private string _query = string.Empty;
    private bool _open = false;
    private bool _loading = false;
    private List<CustomerDto> _customers = new();
    private List<LeadDto> _leads = new();
    private List<DealDto> _deals = new();
    private CancellationTokenSource? _cts;

    private void OnFocus()
    {
        _open = true;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_query))
        {
            _customers.Clear();
            _leads.Clear();
            _deals.Clear();
            _loading = false;
            return;
        }

        _open = true;
        _loading = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                await PerformSearchAsync(token);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task PerformSearchAsync(CancellationToken ct)
    {
        _loading = true;
        try
        {
            var customersTask = CustomerService.GetAllAsync(pageSize: 5, search: _query, cancellationToken: ct);
            var leadsTask = LeadService.GetAllAsync(pageSize: 5, search: _query, cancellationToken: ct);
            var dealsTask = DealService.GetAllAsync(pageSize: 5, search: _query, cancellationToken: ct);

            await Task.WhenAll(customersTask, leadsTask, dealsTask);

            _customers = customersTask.Result.Items;
            _leads = leadsTask.Result.Items;
            _deals = dealsTask.Result.Items;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
        else if (e.Key == "Enter")
        {
            if (_customers.Count > 0)
                GoToCustomer(_customers[0].Id);
            else if (_leads.Count > 0)
                GoToLead(_leads[0].Id);
            else if (_deals.Count > 0)
                GoToDeal(_deals[0].Id);
        }
    }

    private void GoToCustomer(Guid id)
    {
        Close();
        Nav.NavigateTo($"/customers/{id}");
    }

    private void GoToLead(Guid id)
    {
        Close();
        Nav.NavigateTo($"/leads/{id}");
    }

    private void GoToDeal(Guid id)
    {
        Close();
        Nav.NavigateTo($"/deals/{id}");
    }

    private void Close()
    {
        _open = false;
        _query = string.Empty;
        _customers.Clear();
        _leads.Clear();
        _deals.Clear();
    }

    public void Dispose()
    {
        _cts?.Dispose();
    }
}