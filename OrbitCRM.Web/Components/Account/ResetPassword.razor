@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using OrbitCRM.Domain.Identity
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Reset password · OrbitCRM</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-8">
            <h1 class="text-2xl font-semibold text-slate-900 mb-2">Reset password</h1>
            <p class="text-sm text-slate-500 mb-6">Choose a new password for your account.</p>

            @if (_success)
            {
                <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 text-sm rounded-md">
                    Password reset successful. Redirecting to login…
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
                        @_error
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="reset-password-form">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">New password</label>
                        <InputText type="password"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   @bind-Value="_model.Password" />
                        <ValidationMessage For="() => _model.Password" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Confirm new password</label>
                        <InputText type="password"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   @bind-Value="_model.ConfirmPassword" />
                        <ValidationMessage For="() => _model.ConfirmPassword" class="text-xs text-red-600 mt-1" />
                    </div>

                    <button type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md disabled:opacity-60"
                            disabled="@_loading">
                        @(_loading ? "Resetting…" : "Reset password")
                    </button>
                </EditForm>
            }

            @if (!_success)
            {
                <p class="text-sm text-slate-500 text-center mt-6">
                    <a href="/Account/Login" class="text-blue-600 hover:text-blue-700 font-medium">← Back to sign in</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private ResetPasswordModel _model = new();
    private bool _loading;
    private bool _success;
    private string? _error;

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = null;

        try
        {
            if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
            {
                _error = "Invalid reset link. Please request a new one.";
                return;
            }

            var user = await UserManager.FindByEmailAsync(Email);
            if (user is null)
            {
                _error = "Invalid reset link.";
                return;
            }

            // Decode the token
            string decodedToken;
            try
            {
                decodedToken = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            }
            catch
            {
                _error = "Invalid reset link. Please request a new one.";
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, decodedToken, _model.Password);

            if (result.Succeeded)
            {
                _success = true;
                await Task.Delay(2000);
                Nav.NavigateTo("/Account/Login?reset=success");
            }
            else
            {
                _error = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            _error = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public class ResetPasswordModel
    {
        [Required]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}