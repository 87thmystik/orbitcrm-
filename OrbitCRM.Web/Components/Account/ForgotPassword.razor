@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using OrbitCRM.Domain.Identity
@using OrbitCRM.Infrastructure.Services
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Forgot password · OrbitCRM</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-8">
            <h1 class="text-2xl font-semibold text-slate-900 mb-2">Forgot password?</h1>
            <p class="text-sm text-slate-500 mb-6">
                Enter your email and we'll send you a link to reset it.
            </p>

            @if (_sent)
            {
                <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 text-sm rounded-md">
                    If an account exists for <strong>@_email</strong>, we've sent a reset link.
                </div>

                <p class="text-sm text-slate-500">
                    Didn't get the email? In development, check the <strong>VS Output window</strong> — the reset link is printed there.
                </p>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
                        @_error
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="forgot-password-form">
                    <DataAnnotationsValidator />

                    <div class="mb-6">
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
                        <InputText type="email"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   @bind-Value="_model.Email" />
                        <ValidationMessage For="() => _model.Email" class="text-xs text-red-600 mt-1" />
                    </div>

                    <button type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-md disabled:opacity-60"
                            disabled="@_loading">
                        @(_loading ? "Sending…" : "Send reset link")
                    </button>
                </EditForm>
            }

            <p class="text-sm text-slate-500 text-center mt-6">
                <a href="/Account/Login" class="text-blue-600 hover:text-blue-700 font-medium">← Back to sign in</a>
            </p>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel _model = new();
    private bool _loading;
    private bool _sent;
    private string? _error;
    private string? _email;

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = null;
        _email = _model.Email;

        try
        {
            var user = await UserManager.FindByEmailAsync(_model.Email);

            // Always show the same success message (prevents email harvesting)
            if (user is null)
            {
                _sent = true;
                return;
            }

            // Generate a secure, time-limited reset token
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);

            // Encode the token for use in a URL
            var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));

            // Build the reset link
            var baseUrl = Config["AppUrl"] ?? "https://localhost:7070";
            var resetUrl = $"{baseUrl.TrimEnd('/')}/Account/ResetPassword?email={Uri.EscapeDataString(user.Email ?? "")}&code={encodedToken}";

            // Send the email
            await EmailService.SendAsync(
                to: user.Email!,
                subject: "Reset your OrbitCRM password",
                body: $@"
Hi {user.FirstName},

Someone (hopefully you) requested a password reset for your OrbitCRM account.

Click the link below to reset your password:

{resetUrl}

This link expires in 1 hour.

If you didn't request this, you can safely ignore this email — your password has not been changed.
");

            _sent = true;
        }
        catch (Exception ex)
        {
            _error = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}