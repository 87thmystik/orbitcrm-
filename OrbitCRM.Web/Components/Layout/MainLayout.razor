@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="min-h-screen flex flex-col md:flex-row">
    <aside class="md:w-64 md:min-h-screen bg-[#0f172a] border-r border-slate-800 text-white shrink-0 shadow-xl z-20 relative">
        <NavMenu />
    </aside>

    <main class="flex-1 bg-slate-50">
        <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-6 sticky top-0 z-10 gap-4">
            <span class="text-sm text-slate-500 shrink-0">OrbitCRM · Demo Tenant</span>

            <div class="flex items-center gap-3 flex-1 justify-end">
                <GlobalSearch />
                
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-4">
                            <NotificationBell />
                            <span class="text-sm text-slate-700">@context.User.Identity?.Name</span>
                            <a href="/account/logout-post" class="text-sm text-slate-500 hover:text-slate-700">Sign out</a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Account/Login" class="text-sm text-blue-600 hover:text-blue-700">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="p-6">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Notice: NO OnAfterRenderAsync, NO JS.InvokeVoidAsync, NO IJSRuntime injection here.
    // The click-outside handling for search is now done purely in Blazor in GlobalSearch.razor.
}