@page "/tasks/{Id:guid}"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@using OrbitCRM.Application.Tasks.Interfaces
@using OrbitCRM.Domain.Enums
@inject ITaskService TaskService
@inject NavigationManager Nav

<PageTitle>@(_task?.Title ?? "Task") · OrbitCRM</PageTitle>

<div class="max-w-3xl">
    <button class="text-sm text-slate-500 hover:text-slate-700 mb-4" @onclick="BackToList">
        ← Back to Tasks
    </button>

    @if (_loading)
    {
        <p class="text-slate-500 text-sm py-8">Loading…</p>
    }
    else if (_task is null)
    {
        <div class="bg-white border border-slate-200 rounded-lg p-6">
            <p class="text-slate-500 text-sm">Task not found.</p>
        </div>
    }
    else
    {
        <div class="flex items-start justify-between mb-6">
            <div>
                <h1 class="text-2xl font-semibold text-slate-900 @(_task.Status == TaskItemStatus.Completed ? "line-through" : "")">
                    @_task.Title
                </h1>
                <div class="flex gap-3 items-center mt-2">
                    <TaskStatusBadge Status="_task.Status" />
                    <PriorityBadge Priority="_task.Priority" />
                </div>
            </div>

            <div class="flex gap-2">
                @if (_task.Status == TaskItemStatus.Completed)
                {
                    <button class="px-3 py-1.5 text-sm bg-amber-600 hover:bg-amber-700 text-white rounded-md"
                            @onclick="HandleReopen">Reopen</button>
                }
                else
                {
                    <button class="px-3 py-1.5 text-sm bg-green-600 hover:bg-green-700 text-white rounded-md"
                            @onclick="HandleComplete">Mark Complete</button>
                }
                <button class="px-3 py-1.5 text-sm border border-slate-300 rounded-md hover:bg-slate-50"
                        @onclick="GoToEdit">Edit</button>
                <button class="px-3 py-1.5 text-sm bg-red-600 hover:bg-red-700 text-white rounded-md"
                        @onclick="OpenDeleteConfirm">Delete</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
                @_errorMessage
            </div>
        }

        <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">
            <ReadOnlyRow Label="Due Date" Value="@(_task.DueDate?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")" />
            <ReadOnlyRow Label="Customer" Value="@(_task.CustomerName ?? "—")" />
            <ReadOnlyRow Label="Lead" Value="@(_task.LeadName ?? "—")" />
            <ReadOnlyRow Label="Deal" Value="@(_task.DealName ?? "—")" />
            <ReadOnlyRow Label="Description" Value="@(_task.Description ?? "—")" />
            <ReadOnlyRow Label="Created" Value="@_task.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")" />
            @if (_task.CompletedAt.HasValue)
            {
                <ReadOnlyRow Label="Completed" Value="@_task.CompletedAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")" />
            }
        </div>
    }
</div>

<ConfirmDialog IsOpen="_showDeleteConfirm"
               Title="Delete task?"
               Message="This will hide the task from all views."
               ConfirmLabel="Delete"
               Busy="_deleting"
               OnConfirm="HandleDelete"
               OnCancel="CloseDeleteConfirm" />

@code {
    [Parameter] public Guid Id { get; set; }

    private TaskDto? _task;
    private bool _loading = true;
    private bool _deleting;
    private bool _showDeleteConfirm;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _task = await TaskService.GetByIdAsync(Id);
        _loading = false;

        if (_task is null) Nav.NavigateTo("/tasks");
    }

    private void BackToList() => Nav.NavigateTo("/tasks");
    private void GoToEdit() => Nav.NavigateTo($"/tasks/{Id}/edit");
    private void OpenDeleteConfirm() => _showDeleteConfirm = true;
    private void CloseDeleteConfirm() => _showDeleteConfirm = false;

    private async Task HandleComplete()
    {
        var result = await TaskService.CompleteAsync(Id);
        if (result.IsSuccess) _task = await TaskService.GetByIdAsync(Id);
        else _errorMessage = result.Error;
    }

    private async Task HandleReopen()
    {
        var result = await TaskService.ReopenAsync(Id);
        if (result.IsSuccess) _task = await TaskService.GetByIdAsync(Id);
        else _errorMessage = result.Error;
    }

    private async Task HandleDelete()
    {
        _deleting = true;
        try
        {
            var result = await TaskService.DeleteAsync(Id);
            if (result.IsSuccess) Nav.NavigateTo("/tasks");
            else { _errorMessage = result.Error; _showDeleteConfirm = false; }
        }
        finally { _deleting = false; }
    }
}