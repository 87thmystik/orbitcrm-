@page "/settings/users"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using OrbitCRM.Application.Users.DTOs
@using OrbitCRM.Application.Users.Interfaces
@using OrbitCRM.Domain.Identity
@inject IUserService UserService

<PageTitle>Users · OrbitCRM</PageTitle>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-slate-900">Users</h1>
        <p class="text-sm text-slate-500 mt-1">Manage who has access to this workspace.</p>
    </div>

    <button class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-md shadow-sm"
            @onclick="() => _showCreate = true">
        + Invite User
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
        @_error
    </div>
}

@if (!string.IsNullOrEmpty(_success))
{
    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 text-sm rounded-md">
        @_success
    </div>
}

@if (_loading)
{
    <div class="text-slate-500 text-sm py-8">Loading users…</div>
}
else if (_users.Count == 0)
{
    <div class="bg-white border border-slate-200 rounded-lg p-12 text-center">
        <p class="text-slate-600 font-medium">No users yet</p>
    </div>
}
else
{
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="text-left font-medium text-slate-600 px-4 py-3">Name</th>
                    <th class="text-left font-medium text-slate-600 px-4 py-3">Email</th>
                    <th class="text-left font-medium text-slate-600 px-4 py-3">Role</th>
                    <th class="text-left font-medium text-slate-600 px-4 py-3">Status</th>
                    <th class="text-left font-medium text-slate-600 px-4 py-3">Joined</th>
                    <th class="text-right font-medium text-slate-600 px-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var u in _users)
                {
                    var captured = u;
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3 font-medium text-slate-900">@captured.FullName</td>
                        <td class="px-4 py-3 text-slate-600">@captured.Email</td>
                        <td class="px-4 py-3">
                            @if (captured.Role == Roles.Owner)
                            {
                                <span class="text-xs font-medium bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded">@captured.Role</span>
                            }
                            else
                            {
                                <select class="text-xs border border-slate-300 rounded px-2 py-1 focus:outline-none"
                                        value="@captured.Role"
                                        @onchange="e => OnRoleChanged(captured.UserId, e.Value?.ToString())">
                                    @foreach (var r in Roles.All())
                                    {
                                        <option value="@r" selected="@(r == captured.Role)">@r</option>
                                    }
                                </select>
                            }
                        </td>
                        <td class="px-4 py-3">
                            @if (captured.IsActive)
                            {
                                <span class="text-xs font-medium bg-green-100 text-green-700 px-2 py-0.5 rounded">Active</span>
                            }
                            else
                            {
                                <span class="text-xs font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Inactive</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-slate-500">@captured.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                        <td class="px-4 py-3 text-right">
                            @if (captured.Role != Roles.Owner)
                            {
                                <button class="text-xs @(captured.IsActive ? "text-red-600 hover:text-red-700" : "text-green-600 hover:text-green-700")"
                                        @onclick="() => ToggleActive(captured)">
                                    @(captured.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showCreate)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/50" @onclick="() => _showCreate = false"></div>

        <div class="relative bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6 z-10">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Invite User</h3>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="mb-3 p-2 bg-red-50 border border-red-200 text-red-800 text-xs rounded">
                    @_createError
                </div>
            }

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">First Name</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm"
                           @bind="_newUser.FirstName" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Last Name</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm"
                           @bind="_newUser.LastName" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
                    <input type="email" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm"
                           @bind="_newUser.Email" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Temporary Password</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm font-mono"
                           @bind="_newUser.Password" />
                    <p class="text-xs text-slate-400 mt-1">At least 8 chars, upper, lower, digit.</p>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Role</label>
                    <select class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm" @bind="_newUser.Role">
                        @foreach (var r in Roles.All())
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button class="px-4 py-2 text-sm border border-slate-300 rounded-md hover:bg-slate-50"
                        @onclick="() => _showCreate = false">
                    Cancel
                </button>
                <button class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-md disabled:opacity-50"
                        disabled="@_creating"
                        @onclick="CreateUser">
                    @(_creating ? "Creating…" : "Create User")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<TenantUserDto> _users = new();
    private bool _loading = true;
    private bool _showCreate;
    private bool _creating;
    private string? _error;
    private string? _success;
    private string? _createError;

    private CreateUserDto _newUser = new() { Role = Roles.SalesRep };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _users = await UserService.GetTenantUsersAsync();
        _loading = false;
    }

    private async Task OnRoleChanged(Guid userId, string? role)
    {
        if (string.IsNullOrEmpty(role)) return;

        _error = null; _success = null;
        var result = await UserService.UpdateUserRoleAsync(new UpdateUserRoleDto
        {
            UserId = userId,
            Role = role
        });

        if (result.IsSuccess)
        {
            _success = "Role updated.";
            await LoadAsync();
        }
        else
        {
            _error = result.Error;
        }
    }

    private async Task ToggleActive(TenantUserDto user)
    {
        _error = null; _success = null;
        var result = await UserService.SetActiveAsync(user.UserId, !user.IsActive);

        if (result.IsSuccess)
        {
            _success = user.IsActive ? "User deactivated." : "User activated.";
            await LoadAsync();
        }
        else
        {
            _error = result.Error;
        }
    }

    private async Task CreateUser()
    {
        _creating = true;
        _createError = null;

        try
        {
            var result = await UserService.CreateUserAsync(_newUser);

            if (result.IsSuccess)
            {
                _showCreate = false;
                _newUser = new CreateUserDto { Role = Roles.SalesRep };
                _success = "User created.";
                await LoadAsync();
            }
            else
            {
                _createError = result.Error;
            }
        }
        finally
        {
            _creating = false;
        }
    }
}