@page "/customers/new"
@page "/customers/{Id:guid}/edit"
@rendermode @(new InteractiveServerRenderMode())
@using System.ComponentModel.DataAnnotations
@using OrbitCRM.Application.Customers.DTOs
@using OrbitCRM.Application.Customers.Interfaces
@inject ICustomerService CustomerService
@inject NavigationManager Nav

<PageTitle>@_pageTitle · OrbitCRM</PageTitle>

<div class="max-w-2xl">
    <button class="text-sm text-slate-500 hover:text-slate-700 mb-4"
            @onclick="BackToList">
        ← Back to Customers
    </button>

    <h1 class="text-2xl font-semibold text-slate-900 mb-6">@_pageTitle</h1>

    @if (_loading)
    {
        <p class="text-slate-500 text-sm py-8">Loading…</p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="customer-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-sm text-red-600 mb-4" />

            <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <FormField Label="First Name" Required>
                        <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind-Value="_model.FirstName" />
                        <ValidationMessage For="() => _model.FirstName" class="text-xs text-red-600 mt-1" />
                    </FormField>

                    <FormField Label="Last Name" Required>
                        <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind-Value="_model.LastName" />
                        <ValidationMessage For="() => _model.LastName" class="text-xs text-red-600 mt-1" />
                    </FormField>
                </div>

                <FormField Label="Email" Required>
                    <InputText type="email"
                               class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" class="text-xs text-red-600 mt-1" />
                </FormField>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <FormField Label="Phone">
                        <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind-Value="_model.Phone" />
                        <ValidationMessage For="() => _model.Phone" class="text-xs text-red-600 mt-1" />
                    </FormField>

                    <FormField Label="Company">
                        <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind-Value="_model.CompanyName" />
                        <ValidationMessage For="() => _model.CompanyName" class="text-xs text-red-600 mt-1" />
                    </FormField>
                </div>

                <FormField Label="Address">
                    <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               @bind-Value="_model.Address" />
                    <ValidationMessage For="() => _model.Address" class="text-xs text-red-600 mt-1" />
                </FormField>

                <FormField Label="Notes">
                    <InputTextArea rows="3"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind-Value="_model.Notes" />
                    <ValidationMessage For="() => _model.Notes" class="text-xs text-red-600 mt-1" />
                </FormField>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mt-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
                    @_errorMessage
                </div>
            }

            <div class="flex justify-end gap-2 mt-6">
                <button type="button"
                        class="px-4 py-2 text-sm border border-slate-300 rounded-md hover:bg-slate-50"
                        @onclick="BackToList">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-md disabled:opacity-60"
                        disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private CustomerFormModel _model = new();
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private bool IsEdit => Id is not null && Id != Guid.Empty;
    private string _pageTitle => IsEdit ? "Edit Customer" : "New Customer";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _errorMessage = null;

        if (IsEdit)
        {
            var customer = await CustomerService.GetByIdAsync(Id!.Value);
            if (customer is null)
            {
                Nav.NavigateTo("/customers");
                return;
            }
            _model = new CustomerFormModel
            {
                FirstName = customer.FirstName,
                LastName = customer.LastName,
                Email = customer.Email,
                Phone = customer.Phone,
                CompanyName = customer.CompanyName,
                Address = customer.Address,
                Notes = customer.Notes
            };
        }
        else
        {
            _model = new CustomerFormModel();
        }

        _loading = false;
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        _errorMessage = null;

        try
        {
            if (IsEdit)
            {
                var dto = new UpdateCustomerDto
                {
                    Id = Id!.Value,
                    FirstName = _model.FirstName,
                    LastName = _model.LastName,
                    Email = _model.Email,
                    Phone = _model.Phone,
                    CompanyName = _model.CompanyName,
                    Address = _model.Address,
                    Notes = _model.Notes
                };

                var result = await CustomerService.UpdateAsync(dto);
                if (result.IsSuccess)
                {
                    Nav.NavigateTo($"/customers/{Id}");
                }
                else
                {
                    _errorMessage = result.Error;
                }
            }
            else
            {
                var dto = new CreateCustomerDto
                {
                    FirstName = _model.FirstName,
                    LastName = _model.LastName,
                    Email = _model.Email,
                    Phone = _model.Phone,
                    CompanyName = _model.CompanyName,
                    Address = _model.Address,
                    Notes = _model.Notes
                };

                var result = await CustomerService.CreateAsync(dto);
                if (result.IsSuccess)
                {
                    Nav.NavigateTo($"/customers/{result.Value}");
                }
                else
                {
                    _errorMessage = result.Error;
                }
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void BackToList() => Nav.NavigateTo("/customers");

    public class CustomerFormModel
    {
        [Required(ErrorMessage = "First name is required.")]
        [StringLength(100, ErrorMessage = "First name cannot exceed 100 characters.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required.")]
        [StringLength(100, ErrorMessage = "Last name cannot exceed 100 characters.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(255, ErrorMessage = "Email cannot exceed 255 characters.")]
        public string Email { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Phone cannot exceed 50 characters.")]
        public string? Phone { get; set; }

        [StringLength(200, ErrorMessage = "Company cannot exceed 200 characters.")]
        public string? CompanyName { get; set; }

        [StringLength(500, ErrorMessage = "Address cannot exceed 500 characters.")]
        public string? Address { get; set; }

        [StringLength(4000, ErrorMessage = "Notes cannot exceed 4000 characters.")]
        public string? Notes { get; set; }
    }
}