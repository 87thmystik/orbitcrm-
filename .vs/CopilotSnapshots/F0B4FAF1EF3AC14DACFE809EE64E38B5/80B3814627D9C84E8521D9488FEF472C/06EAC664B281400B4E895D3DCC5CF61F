@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using OrbitCRM.Application.Dashboard.DTOs
@using OrbitCRM.Application.Dashboard.Interfaces
@inject IDashboardService DashboardService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard · OrbitCRM</PageTitle>

@if (_loading)
{
    <div class="flex flex-col items-center justify-center min-h-[500px]">
        <div class="relative w-16 h-16 mb-4">
            <div class="absolute inset-0 rounded-xl bg-blue-600/20 animate-ping"></div>
            <div class="relative flex items-center justify-center w-16 h-16 rounded-xl bg-white border border-slate-200 shadow-lg">
                <svg class="animate-spin w-7 h-7 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
        </div>
        <p class="text-slate-600 font-semibold text-sm animate-pulse">Assembling your workspace...</p>
    </div>
}
else if (_summary is null)
{
    <div class="max-w-md mx-auto mt-16 bg-white border border-slate-200/80 shadow-xl rounded-2xl p-8 text-center">
        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 shadow-sm">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h2 class="text-slate-900 font-bold text-lg">Unable to load dashboard</h2>
        <p class="text-slate-500 text-sm mt-1 mb-6">We couldn't synchronize your metrics right now. Please verify your connection.</p>
        <button class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm transition-all shadow-sm"
                @onclick="ReloadDashboard">
            Try Again
        </button>
    </div>
}
else
{
    <!-- Hero Banner -->
    <div class="relative bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 rounded-2xl p-6 md:p-8 mb-6 text-white shadow-2xl overflow-hidden border border-slate-800/80">
        <div class="absolute -right-12 -top-12 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute right-1/3 -bottom-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-blue-300 text-xs font-semibold mb-3 backdrop-blur-md border border-white/10 shadow-inner">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Live Synchronized
                </div>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">@_greeting, @_firstName 👋</h1>
                <p class="text-slate-300 text-sm mt-1 max-w-xl">
                    Your performance metrics are trending well. Here is a high-level briefing of your active pipeline and team tasks.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-2.5">
                <button @onclick="GoToNewDeal"
                        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs transition-all shadow-lg shadow-blue-600/20 active:scale-95">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    New Deal
                </button>
                <button @onclick="GoToNewTask"
                        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs transition-all backdrop-blur-md border border-white/15 active:scale-95">
                    <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    Add Task
                </button>
                <button @onclick="ReloadDashboard"
                        title="Refresh"
                        class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-white/10 hover:bg-white/20 text-white transition-all backdrop-blur-md border border-white/15 active:scale-95">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- KPI Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 mb-6">

        <!-- Customers -->
        <button @onclick="GoToCustomers"
                class="text-left bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-blue-50 group-hover:bg-blue-600 text-blue-600 group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 shadow-inner">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5.13a4 4 0 11-8 0 4 4 0 018 0zm6 0a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <div class="text-xl font-bold tracking-tight text-slate-900">@_summary.TotalCustomers.ToString("N0")</div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Customers</div>
        </button>

        <!-- Active Leads -->
        <button @onclick="GoToLeads"
                class="text-left bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-purple-50 group-hover:bg-purple-600 text-purple-600 group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 shadow-inner">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
            </div>
            <div class="text-xl font-bold tracking-tight text-slate-900">@_summary.ActiveLeads.ToString("N0")</div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Active Leads</div>
        </button>

        <!-- Open Deals -->
        <button @onclick="GoToDeals"
                class="text-left bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group">
            <div class="w-10 h-10 rounded-xl bg-amber-50 group-hover:bg-amber-500 text-amber-600 group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 shadow-inner">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <div class="text-xl font-bold tracking-tight text-slate-900">@_summary.OpenDeals.ToString("N0")</div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Open Deals</div>
        </button>

        <!-- Pipeline Value -->
        <button @onclick="GoToPipeline"
                class="text-left bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl p-4 shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 text-white relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center mb-3 backdrop-blur-md shadow-inner">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="text-xl font-extrabold tracking-tight">@_summary.PipelineValue.ToString("C0")</div>
            <div class="text-xs font-semibold text-blue-100/85 uppercase tracking-wider mt-1">Pipeline Value</div>
        </button>

        <!-- Won Revenue -->
        <button @onclick="GoToDeals"
                class="text-left bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl p-4 shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 text-white relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
            <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center mb-3 backdrop-blur-md shadow-inner">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
            </div>
            <div class="text-xl font-extrabold tracking-tight">@_summary.WonRevenue.ToString("C0")</div>
            <div class="text-xs font-semibold text-emerald-100/85 uppercase tracking-wider mt-1">Won Revenue</div>
        </button>

        <!-- Overdue Tasks -->
        <button @onclick="GoToOverdueTasks"
                class="@(_summary.OverdueTasks > 0 ? "bg-gradient-to-br from-rose-600 to-red-700 text-white shadow-md shadow-rose-600/20" : "bg-white border border-slate-200/80 text-slate-900 shadow-sm") text-left rounded-2xl p-4 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden group">
            <div class="w-10 h-10 rounded-xl @(_summary.OverdueTasks > 0 ? "bg-white/20 text-white" : "bg-rose-50 text-rose-600") flex items-center justify-center mb-3 backdrop-blur-md shadow-inner transition-all">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="text-xl font-extrabold tracking-tight">@_summary.OverdueTasks.ToString("N0")</div>
            <div class="text-xs font-semibold @(_summary.OverdueTasks > 0 ? "text-rose-100/85" : "text-slate-400") uppercase tracking-wider mt-1">Overdue Tasks</div>
        </button>

    </div>

    <!-- Sales Pipeline Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
            <div>
                <h2 class="text-lg font-bold text-slate-900 tracking-tight">Sales Pipeline Distribution</h2>
                <p class="text-xs text-slate-500 mt-0.5">Real-time revenue spread and deal concentration across pipeline stages</p>
            </div>
            <a href="/pipeline" class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50/80 hover:bg-blue-100 px-3.5 py-2 rounded-xl transition-all shadow-sm">
                Open Kanban Board
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>

        @if (_summary.PipelineByStage.Count == 0)
        {
            <div class="py-12 text-center">
                <p class="text-sm text-slate-400 italic">No pipeline stages configured in the system.</p>
            </div>
        }
        else
        {
            var maxValue = _summary.PipelineByStage.Max(s => s.TotalValue);
            if (maxValue <= 0) maxValue = 1;

            <div class="space-y-4">
                @foreach (var stage in _summary.PipelineByStage)
                {
                    var pct = (double)(stage.TotalValue / maxValue) * 100;

                    <div class="bg-slate-50/60 hover:bg-slate-50 p-4 rounded-2xl border border-slate-100 transition-all">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2.5">
                            <div class="flex items-center gap-3">
                                <span class="w-3.5 h-3.5 rounded-full shadow-sm ring-4 ring-white" style="background-color: @(stage.Color ?? "#6b7280");"></span>
                                <span class="text-sm font-bold text-slate-900">@stage.StageName</span>
                                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-0.5 rounded-full border border-slate-200/60 shadow-2xs">@stage.Probability% probability</span>
                            </div>
                            <div class="flex items-baseline gap-3 text-right">
                                <span class="text-sm font-extrabold text-slate-900">@stage.TotalValue.ToString("C0")</span>
                                <span class="text-xs font-medium text-slate-400">@stage.DealCount deal@(stage.DealCount == 1 ? "" : "s")</span>
                            </div>
                        </div>
                        <div class="h-3 bg-slate-200/70 rounded-full overflow-hidden p-0.5 shadow-inner">
                            <div class="h-full rounded-full transition-all duration-1000 ease-out shadow-xs"
                                 style="width: @(Math.Max(pct, 4))%; background-color: @(stage.Color ?? "#6b7280");"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Three-Column Grid Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- Recent Deals -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <h2 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Recent Deals</h2>
                <a href="/deals" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors">View all →</a>
            </div>

            @if (_summary.RecentDeals.Count == 0)
            {
                <div class="flex-1 flex flex-col items-center justify-center py-12 text-center">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                    </div>
                    <p class="text-sm text-slate-400 italic">No open deals available.</p>
                </div>
            }
            else
            {
                <div class="space-y-2.5 flex-1">
                    @foreach (var deal in _summary.RecentDeals)
                    {
                        var captured = deal;
                        <div class="flex items-center justify-between gap-3 cursor-pointer bg-slate-50/50 hover:bg-blue-50/40 p-3 rounded-xl transition-all border border-slate-100 hover:border-blue-100 group"
                             @onclick="() => GoToDeal(captured.Id)">
                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-sm text-slate-900 group-hover:text-blue-600 transition-colors truncate">@captured.Name</div>
                                <div class="text-xs text-slate-500 truncate mt-0.5">
                                    @(captured.CustomerName ?? "No customer assigned")
                                </div>
                                <div class="mt-2">
                                    <StageBadge Name="captured.PipelineStageName" Color="captured.PipelineStageColor" />
                                </div>
                            </div>
                            <div class="text-sm font-extrabold text-slate-900 whitespace-nowrap bg-white px-3 py-2 rounded-xl border border-slate-200/60 shadow-2xs">
                                @captured.Value.ToString("C0")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Today's Activity -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <h2 class="text-xs font-extrabold text-slate-400 uppercase tracking-widest">Today's Activity</h2>
                <a href="/activities" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors">View all →</a>
            </div>

            @if (_summary.TodaysActivities.Count == 0)
            {
                <div class="flex-1 flex flex-col items-center justify-center py-12 text-center">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <p class="text-sm text-slate-400 italic">No activity logged for today.</p>
                </div>
            }
            else
            {
                <div class="space-y-3 flex-1">
                    @foreach (var a in _summary.TodaysActivities)
                    {
                        <div class="flex gap-3.5 p-3 rounded-xl bg-slate-50/50 border border-slate-100 hover:bg-slate-50 transition-colors">
                            <div class="mt-0.5 shrink-0">
                                <ActivityIcon Type="a.Type" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-sm text-slate-900 leading-snug truncate">@a.Subject</div>
                                <div class="text-xs text-slate-400 mt-1 flex items-center gap-1.5 font-medium">
                                    <span class="text-slate-700 font-semibold">@a.OccurredAt.ToLocalTime().ToString("h:mm tt")</span>
                                    <span>·</span>
                                    <span class="truncate text-slate-500">@a.RelatedSummary</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Overdue Tasks -->
        <div class="@(_summary.OverdueTasks > 0 ? "border-rose-200 bg-gradient-to-b from-white to-rose-50/20" : "border-slate-200/80 bg-white") rounded-2xl border shadow-sm p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <h2 class="text-xs font-extrabold @(_summary.OverdueTasks > 0 ? "text-rose-700" : "text-slate-400") uppercase tracking-widest">
                    Overdue Tasks @(_summary.OverdueTasks > 0 ? $"({_summary.OverdueTasks})" : "")
                </h2>
                <a href="/tasks?filter=overdue" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors">View all →</a>
            </div>

            @if (_summary.OverdueTaskList.Count == 0)
            {
                <div class="flex-1 flex flex-col items-center justify-center py-12 text-center">
                    <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2 shadow-2xs">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <p class="text-sm text-slate-600 font-bold">All caught up!</p>
                    <p class="text-xs text-slate-400 mt-0.5">No overdue action items pending.</p>
                </div>
            }
            else
            {
                <div class="space-y-2.5 flex-1">
                    @foreach (var task in _summary.OverdueTaskList)
                    {
                        var captured = task;
                        <div class="flex items-center justify-between gap-3 cursor-pointer bg-white hover:bg-rose-50/60 p-3 rounded-xl transition-all border border-rose-100 shadow-2xs group"
                             @onclick="() => GoToTask(captured.Id)">
                            <div class="min-w-0 flex-1">
                                <div class="font-bold text-sm text-slate-900 group-hover:text-rose-900 truncate">@captured.Title</div>
                                <div class="text-xs text-rose-600 font-bold mt-1 flex items-center gap-1.5">
                                    <span class="bg-rose-100/80 px-2 py-0.5 rounded-md">Due @captured.DueDate!.Value.ToLocalTime().ToString("MMM d")</span>
                                    @if (!string.IsNullOrEmpty(captured.RelatedName))
                                    {
                                        <span class="text-slate-300">·</span>
                                        <span class="text-slate-500 font-medium truncate">@captured.RelatedName</span>
                                    }
                                </div>
                            </div>
                            <PriorityBadge Priority="captured.Priority" />
                        </div>
                    }
                </div>
            }
        </div>

    </div>
}

@code {
    private DashboardSummaryDto? _summary;
    private bool _loading = true;
    private string _greeting = "Welcome";
    private string _firstName = "there";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;
            _firstName = user.FindFirst("given_name")?.Value
                ?? user.Identity?.Name?.Split('@')[0]
                ?? "there";

            var hour = DateTime.Now.Hour;
            _greeting = hour < 12 ? "Good morning"
                      : hour < 17 ? "Good afternoon"
                      : "Good evening";

            _summary = await DashboardService.GetSummaryAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadDashboard() => await LoadDataAsync();

    // Navigation helpers
    private void GoToCustomers() => Nav.NavigateTo("/customers");
    private void GoToLeads() => Nav.NavigateTo("/leads");
    private void GoToDeals() => Nav.NavigateTo("/deals");
    private void GoToPipeline() => Nav.NavigateTo("/pipeline");
    private void GoToOverdueTasks() => Nav.NavigateTo("/tasks?filter=overdue");
    private void GoToNewDeal() => Nav.NavigateTo("/deals/new");
    private void GoToNewTask() => Nav.NavigateTo("/tasks/new");
    private void GoToDeal(Guid id) => Nav.NavigateTo($"/deals/{id}");
    private void GoToTask(Guid id) => Nav.NavigateTo($"/tasks/{id}");
}