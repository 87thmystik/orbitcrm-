@page "/tasks/new"
@page "/tasks/{Id:guid}/edit"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using OrbitCRM.Application.Customers.Interfaces
@using OrbitCRM.Application.Deals.Interfaces
@using OrbitCRM.Application.Leads.Interfaces
@using OrbitCRM.Application.Tasks.DTOs
@using OrbitCRM.Application.Tasks.Interfaces
@using OrbitCRM.Domain.Enums
@inject ITaskService TaskService
@inject ICustomerService CustomerService
@inject ILeadService LeadService
@inject IDealService DealService
@inject NavigationManager Nav

<PageTitle>@_pageTitle · OrbitCRM</PageTitle>

<div class="max-w-2xl">
    <button class="text-sm text-slate-500 hover:text-slate-700 mb-4" @onclick="BackToList">
        ← Back to Tasks
    </button>

    <h1 class="text-2xl font-semibold text-slate-900 mb-6">@_pageTitle</h1>

    @if (_loading)
    {
        <p class="text-slate-500 text-sm py-8">Loading…</p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="task-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-sm text-red-600 mb-4" />

            <div class="bg-white border border-slate-200 rounded-lg p-6 space-y-4">

                <FormField Label="Title" Required>
                    <InputText class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                               @bind-Value="_model.Title" />
                    <ValidationMessage For="() => _model.Title" class="text-xs text-red-600 mt-1" />
                </FormField>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <FormField Label="Due Date">
                        <InputDate class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   @bind-Value="_model.DueDate" />
                    </FormField>

                    <FormField Label="Priority">
                        <InputSelect class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_model.Priority">
                            @foreach (var p in Enum.GetValues<Priority>())
                            {
                                <option value="@p">@p</option>
                            }
                        </InputSelect>
                    </FormField>
                </div>

                @if (IsEdit)
                {
                    <FormField Label="Status">
                        <InputSelect class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_model.Status">
                            @foreach (var s in Enum.GetValues<TaskItemStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </InputSelect>
                    </FormField>
                }

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <FormField Label="Related Customer">
                        <InputSelect class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_model.CustomerId">
                            <option value="">— None —</option>
                            @foreach (var c in _customers)
                            {
                                <option value="@c.Id">@c.FullName</option>
                            }
                        </InputSelect>
                    </FormField>

                    <FormField Label="Related Lead">
                        <InputSelect class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_model.LeadId">
                            <option value="">— None —</option>
                            @foreach (var l in _leads)
                            {
                                <option value="@l.Id">@l.FullName</option>
                            }
                        </InputSelect>
                    </FormField>

                    <FormField Label="Related Deal">
                        <InputSelect class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_model.DealId">
                            <option value="">— None —</option>
                            @foreach (var d in _deals)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </InputSelect>
                    </FormField>
                </div>

                <FormField Label="Description">
                    <InputTextArea rows="3"
                                   class="w-full px-3 py-2 border border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   @bind-Value="_model.Description" />
                </FormField>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mt-4 p-3 bg-red-50 border border-red-200 text-red-800 text-sm rounded-md">
                    @_errorMessage
                </div>
            }

            <div class="flex justify-end gap-2 mt-6">
                <button type="button"
                        class="px-4 py-2 text-sm border border-slate-300 rounded-md hover:bg-slate-50"
                        @onclick="BackToList">Cancel</button>
                <button type="submit"
                        class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-md disabled:opacity-60"
                        disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private TaskFormModel _model = new();
    private List<OrbitCRM.Application.Customers.DTOs.CustomerDto> _customers = new();
    private List<OrbitCRM.Application.Leads.DTOs.LeadDto> _leads = new();
    private List<OrbitCRM.Application.Deals.DTOs.DealDto> _deals = new();
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private bool IsEdit => Id is not null && Id != Guid.Empty;
    private string _pageTitle => IsEdit ? "Edit Task" : "New Task";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _errorMessage = null;

        var cust = await CustomerService.GetAllAsync(pageSize: 200);
        _customers = cust.Items;

        var leads = await LeadService.GetAllAsync(pageSize: 200);
        _leads = leads.Items;

        var deals = await DealService.GetAllAsync(pageSize: 200);
        _deals = deals.Items;

        if (IsEdit)
        {
            var task = await TaskService.GetByIdAsync(Id!.Value);
            if (task is null) { Nav.NavigateTo("/tasks"); return; }

            _model = new TaskFormModel
            {
                Title = task.Title,
                Description = task.Description,
                DueDate = task.DueDate,
                Priority = task.Priority,
                Status = task.Status,
                CustomerId = task.CustomerId,
                LeadId = task.LeadId,
                DealId = task.DealId
            };
        }
        else
        {
            _model = new TaskFormModel();
        }

        _loading = false;
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        _errorMessage = null;

        try
        {
            if (IsEdit)
            {
                var dto = new UpdateTaskDto
                {
                    Id = Id!.Value,
                    Title = _model.Title,
                    Description = _model.Description,
                    DueDate = _model.DueDate,
                    Priority = _model.Priority,
                    Status = _model.Status,
                    CustomerId = _model.CustomerId,
                    LeadId = _model.LeadId,
                    DealId = _model.DealId
                };

                var result = await TaskService.UpdateAsync(dto);
                if (result.IsSuccess) Nav.NavigateTo("/tasks/" + Id.Value);
                else _errorMessage = result.Error;
            }
            else
            {
                var dto = new CreateTaskDto
                {
                    Title = _model.Title,
                    Description = _model.Description,
                    DueDate = _model.DueDate,
                    Priority = _model.Priority,
                    CustomerId = _model.CustomerId,
                    LeadId = _model.LeadId,
                    DealId = _model.DealId
                };

                var result = await TaskService.CreateAsync(dto);
                if (result.IsSuccess) Nav.NavigateTo("/tasks/" + result.Value);
                else _errorMessage = result.Error;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void BackToList() => Nav.NavigateTo("/tasks");

    public class TaskFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        [StringLength(200)]
        public string Title { get; set; } = string.Empty;

        [StringLength(4000)]
        public string? Description { get; set; }

        public DateTime? DueDate { get; set; }

        public Priority Priority { get; set; } = Priority.Medium;

        public TaskItemStatus Status { get; set; } = TaskItemStatus.Pending;

        public Guid? CustomerId { get; set; }
        public Guid? LeadId { get; set; }
        public Guid? DealId { get; set; }
    }
}